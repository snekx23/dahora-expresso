# =====================================================================
# Dahora Expresso — Modelo de Variáveis para Bootstrap do Ambiente DEMO
# Arquivo: .env.bootstrap.demo.example
# IMPORTANTE: Copie este arquivo para .env.bootstrap.demo e preencha as variáveis
# NUNCA inclua senhas, chaves privadas ou tokens reais neste arquivo example.
# =====================================================================

# 1. Configuração do Projeto Supabase DEMO
SUPABASE_URL=
SUPABASE_SECRET_KEY=
EXPECTED_PROJECT_REF=

# 2. Configurações Específicas do Ambiente DEMO
APP_ENV=
ENVIRONMENT_KIND=
DEMO_RESET_ENABLED=

# 3. Conta de Demonstração do Painel Administrativo
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=

# 4. Cliente Comercial de Demonstração
DEMO_CLIENT_EMAIL=
DEMO_CLIENT_PASSWORD=
DEMO_CLIENT_NAME=
DEMO_CLIENT_ESTABLISHMENT=
DEMO_CLIENT_DOCUMENT=
DEMO_CLIENT_PHONE=
DEMO_CLIENT_ADDRESS=

# 5. Motoboy de Demonstração
DEMO_RIDER_EMAIL=
DEMO_RIDER_PASSWORD=
DEMO_RIDER_NAME=
DEMO_RIDER_PHONE=
DEMO_RIDER_VEHICLE=
DEMO_RIDER_PLATE=

# 6. Trava de Confirmação Obrigatória para o Bootstrap DEMO
BOOTSTRAP_CONFIRMATION=

# 7. Opcional: Rotação de senha se o usuário já existir no Auth
ROTATE_EXISTING_PASSWORD=
