{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dahora-expresso",
  "main": "index.js",
  "compatibility_date": "2025-06-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
