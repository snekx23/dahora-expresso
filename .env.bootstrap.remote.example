# =====================================================================
# Dahora Expresso — Modelo de Variáveis para Bootstrap do Ambiente Remoto
# Arquivo: .env.bootstrap.remote.example
# IMPORTANTE: Copie este arquivo para .env.bootstrap.remote e preencha as variáveis
# NUNCA inclua senhas, chaves privadas ou tokens reais neste arquivo example.
# =====================================================================

# 1. Configuração do Projeto Supabase Remoto
SUPABASE_URL=
SUPABASE_SECRET_KEY=
EXPECTED_PROJECT_REF=

# 2. Donos / Administradores Principais (Owner 1 e Owner 2)
OWNER_1_EMAIL=
OWNER_1_PASSWORD=
OWNER_1_NAME=

OWNER_2_EMAIL=
OWNER_2_PASSWORD=
OWNER_2_NAME=

# 2b. Conta de Demonstração do Painel Administrativo (Opcional - Exige ENABLE_DEMO_ADMIN=true e APP_ENV != production)
ENABLE_DEMO_ADMIN=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=

# 3. Cliente Comercial de Demonstração
DEMO_CLIENT_EMAIL=
DEMO_CLIENT_PASSWORD=
DEMO_CLIENT_NAME=
DEMO_CLIENT_ESTABLISHMENT=
DEMO_CLIENT_DOCUMENT=
DEMO_CLIENT_PHONE=
DEMO_CLIENT_ADDRESS=

# 4. Motoboy de Demonstração
DEMO_RIDER_EMAIL=
DEMO_RIDER_PASSWORD=
DEMO_RIDER_NAME=
DEMO_RIDER_PHONE=
DEMO_RIDER_VEHICLE=
DEMO_RIDER_PLATE=

# 5. Trava de Confirmação e Segurança de Ambiente
APP_ENV=
BOOTSTRAP_CONFIRMATION=

# 6. Opcional: Rotação de senha se o usuário já existir no Auth
ROTATE_EXISTING_PASSWORD=
