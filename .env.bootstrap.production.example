# =====================================================================
# Dahora Expresso — Modelo de Variáveis para Bootstrap do Ambiente de Produção
# Arquivo: .env.bootstrap.production.example
# IMPORTANTE: Copie este arquivo para .env.bootstrap.production e preencha as variáveis
# NUNCA inclua senhas, chaves privadas ou tokens reais neste arquivo example.
# =====================================================================

# 1. Configuração do Projeto Supabase de Produção
SUPABASE_URL=
SUPABASE_SECRET_KEY=
EXPECTED_PROJECT_REF=

# 2. Configurações Específicas do Ambiente de Produção
APP_ENV=
ENVIRONMENT_KIND=
DEMO_RESET_ENABLED=

# 3. Donos / Administradores Principais (Owner 1 e Owner 2)
OWNER_1_EMAIL=
OWNER_1_PASSWORD=
OWNER_1_NAME=

OWNER_2_EMAIL=
OWNER_2_PASSWORD=
OWNER_2_NAME=

# 4. Trava de Confirmação Obrigatória para o Bootstrap de Produção
BOOTSTRAP_CONFIRMATION=

# 5. Opcional: Rotação de senha se o usuário já existir no Auth
ROTATE_EXISTING_PASSWORD=
